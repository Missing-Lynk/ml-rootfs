#!/bin/sh
# ml-logd - lightweight flight-session logger to the SD card. Follows the kernel ring buffer and
# samples a few /proc counters so a session can be analysed after the fact (RF/SDIO resets, wave5
# codec errors, CMA exhaustion, OOM). Started by the ml-logd init script only when /mnt/sdcard is
# mounted. Best-effort and bounded: one numbered directory per run, keep the last KEEP, cap the
# kmsg file. Runs are numbered (run-NNNNNN) off a persistent counter, never dated - the clock is not
# trustworthy on this device, so ordering must not depend on it.
#
# Design is deliberately cheap: `cat /dev/kmsg` is a blocking read (0% CPU when the kernel is quiet,
# one open fd, no polling); the sampler wakes every SAMPLE seconds, reads pseudo-files with shell
# builtins (no grep/awk fork), and appends one line. Each tick ends with an fsync of the files it
# wrote; a whole-filesystem sync would also flush the DVR writing the same card.
#
# Correlate the three streams (kernel.log timestamps, stats.csv uptime_s, ml-linkd's rf.log uptime)
# on the shared CLOCK_MONOTONIC axis - they line up even before ntp sets wall time.
set -u
export PATH="/bin:/sbin:/usr/bin:/usr/sbin:$PATH"

LOGROOT=/mnt/sdcard/logs
KEEP=10                          # session directories to retain
SAMPLE=10                        # stats sample period, seconds
KMSG_CAP=$((4 * 1024 * 1024))    # rotate kernel.log past 4 MB (crash-spew safety net)

[ -d /mnt/sdcard ] || { echo "ml-logd: /mnt/sdcard absent, not starting"; exit 0; }
mkdir -p "$LOGROOT" || { echo "ml-logd: cannot create $LOGROOT"; exit 0; }

# Run id: a persistent counter incremented each start (never dated). The counter file is hidden so
# the run-*/ glob never matches it.
CF="$LOGROOT/.runcount"
n=0
[ -f "$CF" ] && read -r n < "$CF" 2>/dev/null
# A power cut mid-write, or the FAT/exFAT damage a battery-out pull leaves behind, leaves this file
# holding something that is not a run number, and $((n + 1)) on that misbehaves in two ways.
# Measured under busybox ash: "12x", "3.5" and anything with an embedded space abort the script with
# "arithmetic syntax error", and because the bad file persists the logger then dies on every
# subsequent boot; "-1" and "0x1f" are instead accepted silently and give a negative or wrong run
# number. (An empty file and a purely alphabetic one are harmless: ash reads them as an unset
# variable, i.e. 0.) Anything that is not a plain decimal number restarts the count.
case "${n:-}" in
	''|*[!0-9]*) n=0 ;;
esac

n=$((n + 1))
echo "$n" > "$CF"
RUN="$(printf 'run-%06d' "$n")"
SDIR="$LOGROOT/$RUN"
mkdir -p "$SDIR"

# Prune to the last KEEP runs, ordered by run NUMBER rather than mtime, so retention stays correct
# with a wrong or rewound clock. The sort is numeric, not lexical: a lexical sort puts run-10000
# below run-9999, and would put a padding-width change or a counter reset (above) below every
# existing directory, in each case pruning the run that just started. The current run is dropped
# from the candidate list outright, so no ordering mistake can ever delete the live session. KEEP
# counts that current run, so the tail offset is KEEP and not KEEP + 1.
for old in "$LOGROOT"/run-*/; do
	[ -d "$old" ] || continue
	[ "$old" = "$SDIR/" ] && continue
	num="${old%/}"
	num="${num##*/run-}"
	case "$num" in
		''|*[!0-9]*) continue ;;
	esac
	echo "$num $old"
done | sort -rn | tail -n +"$KEEP" | while read -r _ old; do
	rm -rf "${old:?}"
done

# One-time context snapshot so a session is self-describing.
{
	echo "run: $RUN"
	uname -a
	echo "--- cmdline ---"; cat /proc/cmdline
	echo "--- lsmod ---";   lsmod
	echo "--- mount ---";   mount
} > "$SDIR/env.txt" 2>/dev/null

# Publish the session dir for ml-linkd (lazy reader; skips if this file is absent). /run is tmpfs.
echo "$SDIR" > /run/ml-log.dir 2>/dev/null

KERN="$SDIR/kernel.log"
STATS="$SDIR/stats.csv"
THREADS="$SDIR/threads.csv"
KPID=""
DIRTY=""      # paths written this tick, fsync'd by sync_dirty

# Opening /dev/kmsg positions at the OLDEST record still in the ring, so every call after the first
# re-appends the whole ring buffer. Rotation avoids that by truncating in place instead of
# restarting the follower; only the died-and-restarted path below pays it, once, and there the
# duplicate is the wanted behaviour anyway (it recovers the records missed while nothing was
# reading).
start_kmsg() {
	cat /dev/kmsg >> "$KERN" 2>/dev/null &
	KPID=$!
}

# Mirror the live service logs (tmpfs /var/log, wiped on reboot) into the session dir, so the SD
# archive is self-contained and survives a power cycle. Runs on each sample tick and once more on
# the way out. Only the bytes appended since the previous tick are copied, with the per-file
# position held in a MIRROR_<key> variable and the byte count pinned before the read, so a service
# writing while the copy runs neither loses a record nor gets one mirrored twice.
#
# ml-pipeline under ML_LATRAW=1 writes ~90 bytes per flip, so its log passes 3 MB within the hour.
# Appending keeps each tick's write proportional to what was logged rather than to the file size,
# which is what lets the fsync below complete inside the tick.
mirror_logs() {
	for f in /var/log/*.log; do
		[ -f "$f" ] || continue
		base="${f##*/}"
		key=$(printf '%s' "$base" | tr -c 'a-zA-Z0-9' '_')   # POSIX sh: no ${var//pat/rep}
		eval "off=\${MIRROR_$key:-0}"
		size=$(stat -c %s "$f" 2>/dev/null) || continue

		# The source shrank: reclaim_var_log truncated it, or the service restarted and reopened it
		# with O_TRUNC. What was mirrored before stays in the session copy and the mirror resumes
		# from the new start, with the seam marked.
		if [ "$size" -lt "$off" ]; then
			echo "--- ml-logd: /var/log/$base restarted (was $off bytes), mirror resumes below ---" >> "$SDIR/$base"
			off=0
		fi

		[ "$size" -gt "$off" ] || continue
		tail -c "+$((off + 1))" "$f" 2>/dev/null | head -c "$((size - off))" >> "$SDIR/$base"
		eval "MIRROR_$key=$size"
		DIRTY="$DIRTY $SDIR/$base"
	done
}

# fsync the files this tick wrote, so the card holds the session up to the last tick after a power
# cut or a wedge; dirty writeback on its own expires at 30 s. The list is per file: a
# whole-filesystem sync would also flush the DVR writing the same card. These are appends, so they
# need the metadata flush that -d skips - without the new size on the card the appended bytes are
# unreachable.
sync_dirty() {
	# shellcheck disable=SC2086  # $DIRTY is a deliberately word-split list of paths
	sync "$STATS" "$THREADS" "$KERN" $DIRTY 2>/dev/null
	DIRTY=""
}

# /var/log is an 8 MiB tmpfs and the service logs append to it for the whole session, so a long or
# chatty run fills it: every daemon's logging then stops mid-session, with nothing in the logs to
# say why. Reclaim the largest one instead. mirror_logs has already copied the current contents to
# the session dir on this same tick, so nothing is lost that is not already on the card, and the
# marker line makes the gap explicit to whoever reads the truncated file later.
VARLOG_FULL_PCT=90

reclaim_var_log() {
	use=$(df /var/log 2>/dev/null | awk 'NR == 2 { sub(/%/, "", $5); print $5 }')
	case "${use:-}" in
		''|*[!0-9]*) return ;;
	esac
	[ "$use" -ge "$VARLOG_FULL_PCT" ] || return

	# shellcheck disable=SC2012  # busybox find has no -printf, and these names never contain newlines
	big=$(ls -S /var/log/*.log 2>/dev/null | head -1)
	[ -n "$big" ] || return
	: > "$big"
	echo "--- ml-logd: /var/log was ${use}% full, truncated here; earlier contents are in $SDIR ---" >> "$big"
}

cleanup() {
	mirror_logs
	sync_dirty
	[ -n "$KPID" ] && kill "$KPID" 2>/dev/null
	rm -f /run/ml-log.dir 2>/dev/null
	exit 0
}
trap cleanup TERM INT

start_kmsg
echo "uptime_s,mem_free_kb,mem_avail_kb,cma_free_kb,cma_total_kb,load1" > "$STATS"

# Per-thread CPU sampling for the video stack. One row per thread per tick with the thread's
# CUMULATIVE utime+stime jiffies and its instantaneous state; the host-side report script does
# the deltas and percentages. A "_cpu" row carries the machine-wide busy/total jiffies from
# /proc/stat for normalisation. All reads are shell builtins on /proc, no forks.
echo "uptime_s,proc,tid,tname,state,jiffies" > "$THREADS"
ENVDONE=""

sample_threads() {
	tup="$1"
	# Machine-wide jiffies: user nice system idle iowait irq softirq steal.
	read -r _ cu cn cs ci cw cq cx cst _ < /proc/stat
	echo "$tup,_cpu,0,total,-,$((cu + cn + cs + ci + cw + cq + cx + cst))" >> "$THREADS"
	echo "$tup,_cpu,0,busy,-,$((cu + cn + cs + cq + cx + cst))" >> "$THREADS"

	for cmf in /proc/[0-9]*/comm; do
		read -r pcomm < "$cmf" 2>/dev/null || continue
		case "$pcomm" in
			ml-pipeline|ml-hud|ml-linkd) ;;
			*) continue ;;
		esac

		pdir="${cmf%/comm}"
		for tst in "$pdir"/task/*/stat; do
			[ -f "$tst" ] || continue
			read -r line < "$tst" 2>/dev/null || continue
			tid="${tst%/stat}"
			tid="${tid##*/}"
			read -r tname < "${tst%/stat}/comm" 2>/dev/null || tname="?"
			# comm may contain spaces: fields resume after the closing paren.
			rest="${line##*) }"
			# shellcheck disable=SC2086  # splitting $rest into fields is the intent
			set -- $rest
			# rest: state ppid pgrp sess tty tpgid flags minflt cminflt majflt cmajflt utime stime
			state="$1"
			ut="${12:-0}"
			st="${13:-0}"
			echo "$tup,$pcomm,$tid,$tname,$state,$((ut + st))" >> "$THREADS"
		done

		# One-shot: stamp the process' ML_* config into env.txt (measurement attribution).
		if [ -z "$ENVDONE" ] && [ "$pcomm" = "ml-pipeline" ]; then
			ENVDONE=1
			{
				echo "--- ml-pipeline ML_* env ---"
				tr '\0' '\n' < "$pdir/environ" 2>/dev/null | grep '^ML_'
			} >> "$SDIR/env.txt" 2>/dev/null
		fi
	done
}

while : ; do
	# uptime (first field of /proc/uptime).
	read -r up _ < /proc/uptime

	# Pull the four meminfo fields with a single builtin pass (no grep/awk fork).
	mf=""; ma=""; cf=""; ct=""
	while read -r key val _ ; do
		case "$key" in
			MemFree:)      mf=$val ;;
			MemAvailable:) ma=$val ;;
			CmaFree:)      cf=$val ;;
			CmaTotal:)     ct=$val ;;
		esac
	done < /proc/meminfo

	read -r l1 _ < /proc/loadavg

	echo "$up,$mf,$ma,$cf,$ct,$l1" >> "$STATS"

	sample_threads "$up"

	mirror_logs
	reclaim_var_log
	sync_dirty

	# Restart the kmsg follower if it died (heavy spew can EPIPE a slow reader).
	if [ -n "$KPID" ] && ! kill -0 "$KPID" 2>/dev/null; then
		start_kmsg
	fi

	# Cap kernel.log: rotate one generation on overflow (rare; a crash loop is the only path).
	# Copy-then-truncate rather than mv-then-restart, because a restarted follower re-opens
	# /dev/kmsg at the oldest record and dumps the whole ring into the new file. During the crash
	# spew that triggers a rotation, that dumped ring is itself most of the next 4 MB, so the
	# rotation feeds itself. Truncating leaves the running follower's append offset at 0 and no
	# record is read twice. The lines written between the copy and the truncate are the cost.
	sz=$(stat -c %s "$KERN" 2>/dev/null || echo 0)
	if [ "$sz" -gt "$KMSG_CAP" ] 2>/dev/null; then
		cp "$KERN" "$KERN.1" 2>/dev/null
		: > "$KERN"
	fi

	sleep "$SAMPLE"
done
