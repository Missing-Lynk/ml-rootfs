#!/bin/sh
# ml-video-up - production launcher (rootfs track): start RF video
# with NO SD card. ml-pipeline here is the standalone fully-static build (whole GStreamer + the
# curated plugin set baked in), so there is no /mnt/gst, no gst-env, no plugin registry - none of the
# squashfs machinery. The development equivalent is userspace/gstreamer/runtime/gst-rf-up.sh on /mnt/gst.
#
# Prerequisites come from the boot services and this rootfs: ml-display (the DRM broker + CRTC
# modeset), ml-hud (the OSD overlay), the kernel modules (wave5, ml_dmablit, artosyn_vo, loaded via
# modules-load.d) and the codec firmware. The RF daemon ml-linkd associates the link and gates the
# video handshake; the ml-video init script owns it, and this script only reports its absence.
#
# Source arg: `rf` (the RF UDP downlink) is the default. RF chip bring-up (releasing the AR8030 from
# reset) is a separate concern and must have happened before the link can associate.
set -e

[ -e /run/missinglynk/drm.sock ] || { echo "FATAL: no DRM broker (/run/missinglynk/drm.sock). Is ml-display up?"; exit 1; }
[ -e /dev/ml-dmablit ] || echo "WARN: /dev/ml-dmablit absent -> CPU-blit fallback (~40 fps). Is ml_dmablit loaded?"

# ml-linkd has exactly one owner: the ml-video init script, which starts it under a pidfile. Warn
# only, never spawn. A second linkd fights the first over the RF control plane, and one started
# here would carry no pidfile, so `rc-service ml-video stop` could not reach it and it would
# interleave into the same log file as the survivor. Match on /proc/*/comm rather than pgrep:
# busybox pgrep -x is unreliable here and pgrep -f matches this script's own command line.
#
# Poll rather than test once. The init script backgrounds ml-linkd immediately before backgrounding
# this script, so both are racing their own exec; a single check would warn on a healthy boot often
# enough to make the warning worth ignoring, which is the opposite of the point.
linkd=""
tries=0
while [ "$tries" -lt 10 ]; do
    if grep -qx ml-linkd /proc/[0-9]*/comm 2>/dev/null; then
        linkd=1
        break
    fi

    tries=$((tries + 1))
    sleep 0.5
done
[ -n "$linkd" ] || echo "WARN: no ml-linkd after 5s -> the RF link will not associate and no video will flow. Is ml-video up?"

# dec_cap_bufs MUST be 0 (stock depth): any cap below the stream's fbc_buf_count (9) makes the
# wave5 firmware spin on display-buffer-full - decode drops to ~25-40 fps with both cores pegged.
# Force it here so no stale modprobe option can reintroduce the regression.
[ -e /sys/module/wave5/parameters/dec_cap_bufs ] && echo 0 > /sys/module/wave5/parameters/dec_cap_bufs

# Composite mode is the default use case: frees a plane for the OSD overlay and produces the frame
# the DVR encodes. ML_HEAP is pinned to the CMA heap here: the binary defaults to the mmz heap
# (ml_mmzheap.ko), but the wave5 ENCODER importing mmz-heap composite dmabufs produces a 0-byte
# recording and wedges the VPU command queue (persistent "result not ready: 0x800"; power cycle to
# recover) - HW-bisected via this very variable. Keep CMA until that import path is fixed.
# DVR records native 1080p60: requires the page-granular coherent-pool kernel (patch 0011);
# on a power-of-2-pool kernel the encoder FBC ENOMEMs (0-byte file) - fall back to
# ML_DVR_RES=720 ML_DVR_FPS=30 there.
#
# Cap the composite pool (ML_COMP_MAX): the CMA heap is shared with the HUD overlay and runtime
# DMA (and on the mmz heap it would share with the wave5 decoders and the DVR encoder), so an
# uncapped greedy grab starves them. 10 x ~3.1 MiB leaves headroom and stays above the 5-buffer
# floor for smooth 60 fps. Override with ML_COMP_MAX to retune.
# Latency-trace toggle: the flag file survives reboots and OpenRC's env scrubbing, so a bench
# session enables the 1 Hz lat lines with
#   touch /usrdata/missinglynk/latstats
# and removes the file when done.
[ -f /usrdata/missinglynk/latstats ] && export ML_LATSTATS=1
[ -f /usrdata/missinglynk/latraw ] && export ML_LATRAW=1


# pmsg: write a per-frame phase trail to /dev/pmsg0 (mlp-pmsg.c ML_PMSG), which is DRAM that
# survives the watchdog reset a freeze ends in. The shipping kernel carries PSTORE_PMSG and the
# board declares a pmsg record, so /dev/pmsg0 is there and this needs no special build; if a
# kernel ever lacks it ml-pipeline says so and carries on.
#
# ON BY DEFAULT, unlike the traces above. A freeze in the air leaves no other evidence: the console
# is silent for minutes beforehand, the unit stops answering ping, and the watchdog resets it, so
# the phase trail is the only record of what the pipeline was doing when the CPU stopped. It has to
# already be running when the freeze happens, and a flying unit has no serial console and nobody to
# set a flag file first. ml-pstore-harvest moves the trail off the ramoops region at the next boot.
#
# The cost is a ~30-byte write per phase, five per frame, into a DRAM ring. Set the flag file to
# turn it off on a unit where even that is unwanted.
[ -f /usrdata/missinglynk/no-pmsg ] || export ML_PMSG=1

# stats: the 2 s counter block (mlp-rf.c ML_STATS). Carries the per-channel FrameId gap and
# lost-frame counts, the per-tile air-encoder BR/QP from the PREFIX_SEI, the seam skip counters,
# and the tile-divergence meter, each line stamped with uptime so a DVR offset indexes into
# ml-logd's stats.csv. ~1.1 MB an hour; the divergence measurement runs only while this is set.
[ -f /usrdata/missinglynk/stats ] && export ML_STATS=1

# dvr-h264: record DVR in H.264 instead of the default H.265 (mlp-record.c ML_DVR_CODEC)
[ -f /usrdata/missinglynk/dvr-h264 ] && export ML_DVR_CODEC=h264

# dvr-bitrate: bits per second for the DVR encoder (mlp-record.c ML_DVR_BITRATE). The file's
# contents enable wave5's rate control and bound the bitstream; absent, the encoder runs at the
# driver's fixed-QP default and its output is unbounded.
if [ -s /usrdata/missinglynk/dvr-bitrate ]; then
    ML_DVR_BITRATE="$(cat /usrdata/missinglynk/dvr-bitrate)"
    export ML_DVR_BITRATE
fi

# seam: how the 32 rows the two RF tiles both carry are resolved (mlp-seam.c ML_SEAM). File
# contents select the mode, an empty file meaning 2:
#   1  split geometry - each tile skips its own overlap rows at the source, so no composite row
#      is written twice; the tiles still meet at a hard cut
#   2  split geometry plus the NEON cross-fade over the band
# Absent: tile 1 is placed over tile 0's copy of those rows, the long-standing behaviour.
if [ -f /usrdata/missinglynk/seam ]; then
    seam=$(cat /usrdata/missinglynk/seam)
    export ML_SEAM="${seam:-2}"
fi

# pace: the display phase loop runs by default. File contents override it: 0 switches it
# off for an A/B against an unpaced run, a rate in Hz seeds its base instead of the mode
# rate. The 1 Hz trace is separate and stays off unless pace-dbg exists.
if [ -f /usrdata/missinglynk/pace ]; then
    seed=$(cat /usrdata/missinglynk/pace)
    export ML_PACE="${seed:-1}"
fi

if [ -f /usrdata/missinglynk/pace-dbg ]; then
    export ML_PACE_DBG=1
fi

# phase-force: file contents = microseconds from the tile-0 submit to the next flip event
# (mlp-pace.c ML_PHASE_FORCE). Bench reproducer for the hard hang; adds up to one vsync of latency.
if [ -f /usrdata/missinglynk/phase-force ]; then
    ML_PHASE_FORCE="$(cat /usrdata/missinglynk/phase-force)"
    export ML_PHASE_FORCE
fi

exec env ML_HEAP="${ML_HEAP:-default_cma_region}" ML_COMPOSE=1 ML_COMP_MAX="${ML_COMP_MAX:-10}" ml-pipeline "${1:-rf}"
