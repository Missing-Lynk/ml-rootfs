#!/sbin/openrc-run
# RF video at boot: bring the AR8030 link up (ml-rf-bringup: reset release + SDIO re-probe +
# firmware download + sdio0 config), start ml-linkd (association + READY-gated handshakes), then
# the standalone ml-pipeline via ml-video-up. Best-effort throughout: any missing piece logs a
# warning and the boot continues.
description="RF video: AR8030 bring-up + ml-linkd + ml-pipeline"

RF_BRINGUP=/usr/local/bin/ml-rf-bringup
RF_FW=bb_demo_gnd_d.img                     # baseband firmware in /lib/firmware (staged by rootfs build)
RF_CFG_RACE=bb_config_gnd.json.usr_cfg.json     # race band, 16 channels: its ground-side config, same dir
RF_CFG_NORMAL=bb_config_gnd.json.normal_cfg.json  # normal band, 3 channels: same blob, chan_valid_bmp rewritten
RF_BAND_MARKER=/usrdata/missinglynk/rf-band     # "normal" selects the normal band; absent/anything else = race
RF_CHAN_MARKER=/usrdata/missinglynk/rf-channel  # per-band saved channel; passed to ml-linkd as ML_OPEN_CHNIDX
LINKD=/usr/local/bin/ml-linkd
VIDEO_UP=/usr/local/bin/ml-video-up

# ml-pipeline runs under supervise-daemon: a crash (wave5 firmware stall, a segfault, an OOM'd
# allocation) is respawned after RESPAWN_DELAY seconds, and the next generation reclaims the
# crashed one's compose pool before allocating its own, so the respawn succeeds. Without this a
# crash left the unit with OSD alive and video black until someone restarted ml-video. Bounded so a
# pipeline that cannot start at all (no DRM broker, no link) does not spin forever: more than
# RESPAWN_MAX starts within RESPAWN_PERIOD seconds and the supervisor gives up and marks the service
# crashed. ml-linkd stays under start-stop-daemon: its restart drops the power/standby assert and
# is never wanted implicitly.
RESPAWN_DELAY="${RESPAWN_DELAY:-2}"
RESPAWN_MAX="${RESPAWN_MAX:-100}"
RESPAWN_PERIOD="${RESPAWN_PERIOD:-600}"

depend() {
	after modules mdev hwdrivers ml-display
}

# The band (Normal/Race) is the config's chan_valid_bmp and only reaches the chip at firmware
# upload, so it is chosen here, once per boot, and a band change needs a reboot to take effect.
rf_cfg() {
	if [ "$(cat "$RF_BAND_MARKER" 2>/dev/null)" = "normal" ] &&
	   [ -f "/lib/firmware/$RF_CFG_NORMAL" ]; then
		echo "$RF_CFG_NORMAL"
	else
		echo "$RF_CFG_RACE"
	fi
}

rf_up() {
	# The whole AR8030 sequence lives in ml-rf-bringup (reset release, SDIO re-probe, firmware
	# download, sdio0 config). It is idempotent - a no-op if artosyn_sdio is already loaded, which
	# is what must happen on a service restart (that driver must NEVER be warm-reloaded: it hangs
	# the device).
	if [ ! -x "$RF_BRINGUP" ]; then
		ewarn "ml-video: $RF_BRINGUP missing - no RF bring-up"
		return 1
	fi

	cfg=$(rf_cfg)
	einfo "ml-video: RF band config $cfg"
	# Prefer a per-device config edited by binding (ml-rf-persist writes the paired air-unit MAC
	# into candidate.slot under /usrdata). ml-rf-bringup writes ML_RF_FW_PATH to the kernel firmware
	# search path, tried before /lib/firmware: the edited cfg wins when present, else the baked cfg
	# (and always the baked bb_demo_gnd_d.img, which is never copied) is used.
	# Bounded, because this runs in the foreground of the default runlevel: a bring-up that wedges
	# rather than fails (the AR8030 sometimes powers up answering a garbage SDIO devid) would
	# otherwise stall the rest of boot indefinitely. A timeout exits non-zero, so the caller's
	# "RF bring-up incomplete" warning covers a hang exactly as it covers a failure.
	ML_RF_FW_PATH=/usrdata/missinglynk timeout 30 "$RF_BRINGUP" "$RF_FW" "$cfg"
}

start() {
	ebegin "Starting RF video"

	rf_up || ewarn "ml-video: RF bring-up incomplete (video will not flow; SSH + serial still work)"

	if [ -x "$LINKD" ]; then
		# The per-band saved channel: ml-linkd opens on it (validated against the loaded band),
		# else its first valid channel. Absent marker -> empty -> ml-linkd's first-valid default.
		ML_OPEN_CHNIDX="$(cat "$RF_CHAN_MARKER" 2>/dev/null)" \
		start-stop-daemon --start --background --make-pidfile \
			--pidfile /run/ml-linkd.pid --exec "$LINKD" \
			--stdout /var/log/ml-linkd.log --stderr /var/log/ml-linkd.log
	else
		ewarn "ml-video: $LINKD missing"
	fi

	if [ -x "$VIDEO_UP" ]; then
		# The pidfile names the supervisor; the pipeline itself is found by comm (pgrep).
		supervise-daemon "$RC_SVCNAME" --start \
			--pidfile /run/ml-pipeline.pid \
			--respawn-delay "$RESPAWN_DELAY" --respawn-max "$RESPAWN_MAX" \
			--respawn-period "$RESPAWN_PERIOD" \
			--stdout /var/log/ml-pipeline.log --stderr /var/log/ml-pipeline.log \
			"$VIDEO_UP" -- rf
	else
		ewarn "ml-video: $VIDEO_UP missing"
	fi

	eend 0
}

stop() {
	ebegin "Stopping RF video (link/driver stay up - never warm-reload artosyn_sdio)"
	# Through the supervisor, so it stops respawning and TERMs the pipeline (graceful teardown).
	supervise-daemon "$RC_SVCNAME" --stop --pidfile /run/ml-pipeline.pid 2>/dev/null
	start-stop-daemon --stop --pidfile /run/ml-linkd.pid 2>/dev/null
	eend 0
}
