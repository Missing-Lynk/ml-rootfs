#!/sbin/openrc-run
# Air-unit auto exposure: meter the ISP's rro_stats zone grid and drive sensor exposure, sensor
# gain and the gain-keyed ISP ladders from one exposure-table index.
description="Air-unit auto exposure: rro_stats metering -> sensor exposure/gain + ISP gain ladders"

AED=/usr/local/bin/ml-aed
PIDFILE=/run/ml-air-ae.pid
LOG=/var/log/ml-air-ae.log

# Appears when ar-isp probes; carries data once frames flow.
STATS=/sys/kernel/debug/ar-isp/stats_raw
DEBUGFS=/sys/kernel/debug

# The operating point the driver commits before stream-on.
START_INDEX=317

# artosyn/<ISP_TUNING_NAME> from board.conf, and the DTB's artosyn,tuning-firmware. A test asserts
# all three agree.
TUNING=/lib/firmware/artosyn/nt99235-tuning-preview-fpv.bin

# ar-cvisp starts the chain at STREAMON, so this races ml-air-camera. The node
# appears when ar-isp probes, seconds before it carries data, so the wait below
# reads it rather than stat-ing it and the budget covers stream-on, not probe.
STATS_WAIT=30

depend() {
	after modules mdev hwdrivers ml-air-camera
}

start() {
	ebegin "Starting air-unit auto exposure"

	if [ ! -x "$AED" ]; then
		ewarn "ml-air-ae: $AED missing - the camera will stream at a fixed exposure"
		eend 0
		return 0
	fi

	# debugfs is not in fstab.
	if [ ! -d "$DEBUGFS/ar-isp" ]; then
		mount -t debugfs none "$DEBUGFS" 2>/dev/null
	fi

	# A successful read, not mere existence: the node exists from ar-isp probe
	# but returns EAGAIN until a frame has completed into a statistics half,
	# which is about twelve seconds later at stream-on.
	i=0
	while [ "$i" -lt "$STATS_WAIT" ]
	do
		head -c 4 "$STATS" >/dev/null 2>&1 && break
		i=$((i + 1))
		sleep 1
	done

	if [ ! -f "$TUNING" ]; then
		ewarn "ml-air-ae: $TUNING missing - exposure stays fixed"
		eend 0
		return 0
	fi

	if [ ! -e "$STATS" ]; then
		ewarn "ml-air-ae: no $STATS after ${STATS_WAIT}s - ar-isp did not probe, exposure stays fixed"
		eend 0
		return 0
	fi

	# The node is there but still dry. Start anyway: ml-aed waits for the first
	# flip instead of exiting, so a camera that comes up late is picked up
	# rather than missed, and the daemon reports the wait in its own log.
	if ! head -c 4 "$STATS" >/dev/null 2>&1; then
		ewarn "ml-air-ae: $STATS carries no frame after ${STATS_WAIT}s - starting anyway, ml-aed will wait"
	fi

	einfo "ml-air-ae: metering from $STATS, starting at index $START_INDEX"

	# Non-verbose: only index moves are logged, which fits the 8 MiB /var/log tmpfs.
	start-stop-daemon --start --background --make-pidfile \
		--pidfile "$PIDFILE" --exec "$AED" \
		--stdout "$LOG" --stderr "$LOG" \
		-- --start-index "$START_INDEX" --tuning "$TUNING"

	eend 0
}

stop() {
	ebegin "Stopping air-unit auto exposure"
	start-stop-daemon --stop --pidfile "$PIDFILE" 2>/dev/null
	eend 0
}
