#!/sbin/openrc-run
# Air-unit RF link at boot: run ml-linkd in air (TX) role, which transmits telemetry and
# MSP DisplayPort OSD from the FC UART to the goggle over sdio0. Association is chip-autonomous
# from the artosyn_sdio insmod config. Best-effort: a missing binary logs a warning and boot
# continues.
#
# RF is brought up (ml-rf-bringup) when the air baseband firmware is present in /lib/firmware;
# otherwise this logs a warning and starts ml-linkd, which waits for sdio0 (retrying the bind and
# the IIO resolve every tick).
description="Air-unit RF link: telemetry/MSP TX (ml-linkd --role air)"

RF_BRINGUP=/usr/local/bin/ml-rf-bringup
RF_FW=bb_demo_air_d.img
RF_CFG=bb_config_air.json
RF_LOG=/var/log/ml-rf-bringup.log
USR_DIR=/usrdata/missinglynk
RF_LEDGER=$USR_DIR/rf-bringup.log
RF_LEDGER_KEEP=200
RF_ATTEMPTS=2
RF_RETRY_WAIT=2
LINKD=/usr/local/bin/ml-linkd

# Where the encoder bitrate comes from: fixed, adapt or probe. Set in /etc/conf.d/ml-air-link,
# which OpenRC sources before this runs; the default here is what an image without that file gets.
RATE_MODE="${RATE_MODE:-adapt}"

depend() {
	after modules mdev hwdrivers
}

start() {
	ebegin "Starting air-unit RF link"

	# Prefer a persisted config over the baked one: ml-rf-persist --air writes the bound peer
	# there after a successful bind, and ml-rf-bringup puts this on the kernel firmware search
	# path so the driver loads it when present and falls back to /lib/firmware otherwise.
	export ML_RF_FW_PATH=/usrdata/missinglynk

	if [ -x "$RF_BRINGUP" ] && [ -f "/lib/firmware/$RF_FW" ] && [ -f "/lib/firmware/$RF_CFG" ]; then
		# The air side of the sdio0 link is 10.0.0.100 (ml-rf-bringup defaults to the
		# ground address 10.0.0.1).
		# Bounded, because this runs in the foreground of the default runlevel: a bring-up that
		# wedges rather than fails would otherwise stall the rest of boot on a device with no
		# panel to show it. A timeout exits non-zero, so the warning below covers a hang too.
		#
		# Logged: ml-rf-bringup names the failing phase on stderr, and OpenRC sends that to the
		# console only, so a boot without sdio0 otherwise leaves no record of which phase failed.
		#
		# Retried once: a boot-time bring-up failed at 16 s with the chip enumerated and
		# artosyn_sdio never inserted, where an identical manual run at 85 s succeeded. The
		# per-attempt outcomes in $RF_LEDGER separate the causes - fail-then-ok is a chip or host
		# not ready at 16 s, two failures is the corrupt power-up device ID
		# (kernel/docs/artosyn-sdio.md), which needs the battery out.
		attempt=1
		rf_ok=1
		while [ "$attempt" -le "$RF_ATTEMPTS" ]; do
			echo "--- attempt $attempt at $(cut -d' ' -f1 /proc/uptime)s uptime" >>"$RF_LOG"
			if ML_RF_SDIO_ADDR=10.0.0.100 timeout 30 "$RF_BRINGUP" "$RF_FW" "$RF_CFG" \
					>>"$RF_LOG" 2>&1; then
				rf_ok=0
				break
			fi

			ewarn "ml-air-link: RF bring-up attempt $attempt failed (see $RF_LOG)"
			if [ "$attempt" -ge "$RF_ATTEMPTS" ]; then
				break
			fi

			attempt=$((attempt + 1))
			sleep "$RF_RETRY_WAIT"
		done

		# One line per boot on the persistent volume: /var/log is tmpfs and does not survive the
		# battery pull that follows a failure. Trimmed to the last $RF_LEDGER_KEEP lines.
		if [ -d "$USR_DIR" ]; then
			printf '%s uptime=%ss attempts=%s result=%s\n' \
				"$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
				"$(cut -d' ' -f1 /proc/uptime)" "$attempt" \
				"$([ "$rf_ok" -eq 0 ] && echo ok || echo fail)" >>"$RF_LEDGER"
			tail -n "$RF_LEDGER_KEEP" "$RF_LEDGER" >"$RF_LEDGER.tmp" 2>/dev/null \
				&& mv "$RF_LEDGER.tmp" "$RF_LEDGER"
		fi

		cat "$RF_LOG"
	else
		ewarn "ml-air-link: air baseband firmware not baked; bring RF up out of band"
	fi

	# --power-adapt: radiated power follows the FC arm state, frame rate follows the goggle's
	# standby arm. A disarmed aircraft holds the minimum whatever the goggle asks for; arming
	# hands power back to the commanded value. With no FC the arm state is unknown rather than
	# disarmed, so the goggle stays authoritative and a bench unit is not pinned low.
	#
	# The standby frame-rate drop needs an ml-air-video carrying the `capfps` verb. build.sh
	# stages both binaries from the same userspace tree so a flashed image is always a matched
	# pair; a HAND-DEPLOYED ml-linkd over an older ml-air-video is not, and fails silently in one
	# direction only - power drops, bitrate does not.
	#
	# RATE_MODE past fixed hands the encoder bitrate to the link: adapt writes it, probe only
	# derives and logs it, sim writes it from a bench profile file instead of the baseband. An
	# unrecognised value runs fixed rather than guessing, and says so, because the difference is
	# invisible in flight and visible only here.
	set -- --role air --hw-version "@HW_VERSION@" --power-adapt
	case "$RATE_MODE" in
		fixed) ;;
		adapt) set -- "$@" --rate-adapt ;;
		probe) set -- "$@" --rate-probe ;;
		sim)   set -- "$@" --rate-sim ;;
		*)
			ewarn "ml-air-link: RATE_MODE=$RATE_MODE unrecognised, running fixed"
			;;
	esac

	if [ -x "$LINKD" ]; then
		einfo "ml-air-link: encoder bitrate $RATE_MODE"
		start-stop-daemon --start --background --make-pidfile \
			--pidfile /run/ml-linkd.pid --exec "$LINKD" \
			--stdout /var/log/ml-linkd.log --stderr /var/log/ml-linkd.log \
			-- "$@"
	else
		ewarn "ml-air-link: $LINKD missing"
	fi

	eend 0
}

stop() {
	ebegin "Stopping air-unit RF link (never warm-reload artosyn_sdio)"
	start-stop-daemon --stop --pidfile /run/ml-linkd.pid 2>/dev/null
	eend 0
}
